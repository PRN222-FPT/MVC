{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "Upload": {
    "MaxFileSizeBytes": 20971520,
    "AllowedExtensions": [
      ".pdf",
      ".docx"
    ],
    "StorageRoot": "uploads"
  },

  "Chunking": {
    "ChunkSize": 1000,
    "ChunkOverlap": 100,
    "Separators": [
      "\r\n",
      "\n\n",
      "\n",
      " ",
      ""
    ]
  },

  "Ocr": {
    "EnableOcr": true,
    "Languages": "vie+eng",
    "Dpi": 300
  },

  "OpenAI": {
    "ApiKey": "",
    "BaseUrl": "https://api.openai.com/v1",
    "EmbeddingModel": "text-embedding-3-small",
    "TimeoutSeconds": 60
  },

  "Qdrant": {
    "Host": "localhost",
    "Port": 6334,
    "Https": false,
    "ApiKey": "",
    "VectorSize": 768
  },

  "Gemini": {
    "ApiKey": "",
    "ModelName": "gemini-2.0-flash-lite",
    "EmbeddingModelName": "text-embedding-004",
    "SystemPrompt": "You are a helpful and precise assistant. Use the provided context to answer the user's question accurately. Keep your response within 300 words. If the context does not contain the answer, say that you cannot find the answer in the provided context."
  }
}
