@model MVC.ViewModels.AdminUsersIndexViewModel
@using ServiceLayer.DTOs

@{
    ViewData["Title"] = "User Control";
}

<div class="d-flex flex-column gap-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <p class="text-secondary fw-bold text-uppercase mb-1" style="font-size: 11px; letter-spacing: .08em;">Admin Console</p>
            <h1 class="h3 fw-bold mb-1">User Control</h1>
            <p class="text-secondary mb-0">Create student and teacher accounts for the document workspace.</p>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="bg-white border rounded-3 p-4 h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <span class="text-secondary fw-semibold">Students</span>
                    <span class="material-icons text-primary">school</span>
                </div>
                <div class="display-6 fw-bold mt-2">@Model.StudentCount</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="bg-white border rounded-3 p-4 h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <span class="text-secondary fw-semibold">Teachers</span>
                    <span class="material-icons text-success">co_present</span>
                </div>
                <div class="display-6 fw-bold mt-2">@Model.TeacherCount</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="bg-white border rounded-3 p-4 h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <span class="text-secondary fw-semibold">Admins</span>
                    <span class="material-icons text-warning">admin_panel_settings</span>
                </div>
                <div class="display-6 fw-bold mt-2">@Model.AdminCount</div>
            </div>
        </div>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success mb-0">@success</div>
    }

    <div class="row g-4">
        <div class="col-xl-4">
            <div class="bg-white border rounded-3 p-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="material-icons text-primary">person_add</span>
                    <h2 class="h5 fw-bold mb-0">Create Account</h2>
                </div>

                <form asp-action="Create" method="post" class="d-flex flex-column gap-3">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div>
                        <label asp-for="CreateUser.FullName" class="form-label small fw-bold text-secondary">Full Name</label>
                        <input asp-for="CreateUser.FullName" class="form-control" placeholder="Nguyen Van A" />
                        <span asp-validation-for="CreateUser.FullName" class="text-danger small"></span>
                    </div>

                    <div>
                        <label asp-for="CreateUser.Email" class="form-label small fw-bold text-secondary">Email</label>
                        <input asp-for="CreateUser.Email" class="form-control" placeholder="student@school.edu" />
                        <span asp-validation-for="CreateUser.Email" class="text-danger small"></span>
                    </div>

                    <div>
                        <label asp-for="CreateUser.Password" class="form-label small fw-bold text-secondary">Temporary Password</label>
                        <input asp-for="CreateUser.Password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="CreateUser.Password" class="text-danger small"></span>
                    </div>

                    <div>
                        <label asp-for="CreateUser.Role" class="form-label small fw-bold text-secondary">Role</label>
                        <select asp-for="CreateUser.Role" asp-items="Model.CreateUser.RoleOptions" class="form-select"></select>
                        <span asp-validation-for="CreateUser.Role" class="text-danger small"></span>
                    </div>

                    <div>
                        <label asp-for="CreateUser.Department" class="form-label small fw-bold text-secondary">Department</label>
                        <input asp-for="CreateUser.Department" class="form-control" placeholder="Required for teacher profiles" />
                        <span asp-validation-for="CreateUser.Department" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary fw-bold d-inline-flex align-items-center justify-content-center gap-2">
                        <span class="material-icons" style="font-size: 20px;">add</span>
                        Create Account
                    </button>
                </form>
            </div>
        </div>

        <div class="col-xl-8">
            <div class="bg-white border rounded-3 overflow-hidden">
                <div class="p-4 border-bottom d-flex align-items-center justify-content-between">
                    <div>
                        <h2 class="h5 fw-bold mb-1">Accounts</h2>
                        <p class="text-secondary small mb-0">Current users with access to DocAssistant AI.</p>
                    </div>
                    <span class="badge text-bg-light border">@Model.Users.Count users</span>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">User</th>
                                <th>Role</th>
                                <th>Created</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.Users)
                            {
                                string badgeClass = user.Role switch
                                {
                                    UserRoles.Admin => "text-bg-warning",
                                    UserRoles.Teacher => "text-bg-success",
                                    _ => "text-bg-primary"
                                };

                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold">@user.FullName</div>
                                        <div class="text-secondary small">@user.Email</div>
                                    </td>
                                    <td>
                                        <span class="badge @badgeClass text-capitalize">@user.Role</span>
                                    </td>
                                    <td class="text-secondary small">
                                        @(user.CreatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "Unknown")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
