@{
    ViewData["Title"] = "Upload Document";
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h2 class="display-6 fw-bold mb-1">Upload Document</h2>
        <p class="text-secondary">Upload new documents for AI analysis.</p>
    </div>
    <a asp-action="Library" class="btn btn-outline-primary d-inline-flex align-items-center gap-2 px-4 py-2 fw-semibold">
        <span class="material-icons">library_books</span> Back to Library
    </a>
</div>

<div class="card border-light shadow-sm rounded-4">
    <div class="card-body p-4 p-lg-5">
        <div class="border border-dashed rounded-4 p-5 text-center bg-light">
            <div class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle mb-3" style="width: 64px; height: 64px;">
                <span class="material-icons fs-2">cloud_upload</span>
            </div>
            <h3 class="h5 fw-bold mb-2">Drag & drop files here</h3>
            <p class="text-secondary mb-4">Supported formats: PDF, DOCX. Max size 50MB.</p>
            <button class="btn btn-primary px-4 py-2 fw-semibold">Browse files</button>
        </div>
    </div>
</div>
