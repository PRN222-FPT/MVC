@model MVC.ViewModels.DocumentViewerViewModel
@using ServiceLayer.DTOs

@{
    ViewData["Title"] = Model.Title;
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h2 class="display-6 fw-bold mb-1">@Model.Title</h2>
        <p class="text-secondary mb-0">@Model.FileName</p>
    </div>
    <div class="d-inline-flex align-items-center gap-2">
        <a asp-action="Library" class="btn btn-outline-primary d-inline-flex align-items-center gap-2 px-4 py-2 fw-semibold">
            <span class="material-icons">library_books</span> Back to Library
        </a>
        @if (User.IsInRole(UserRoles.Teacher))
        {
            <a asp-action="Chunks" asp-route-documentId="@Model.DocumentId"
               class="btn btn-outline-primary d-inline-flex align-items-center gap-2 px-4 py-2 fw-semibold @(Model.IsCompleted ? "" : "d-none")"
               data-view-chunks-link>
                <span class="material-icons">view_list</span> View Chunks
            </a>
        }
        <a href="@Model.DownloadUrl" class="btn btn-primary d-inline-flex align-items-center gap-2 px-4 py-2 fw-semibold">
            <span class="material-icons">download</span> Download
        </a>
    </div>
</div>

<div class="mb-4" data-processing-banner data-document-id="@Model.DocumentId" data-terminal="@Model.IsTerminal.ToString().ToLowerInvariant()">
    @if (!Model.IsCompleted)
    {
        <div class="alert @(Model.Status.Equals("failed", StringComparison.OrdinalIgnoreCase) ? "alert-danger" : "alert-info") d-flex flex-column gap-2 mb-0" data-banner-alert>
            <div class="d-flex align-items-center justify-content-between">
                <span class="fw-semibold" data-banner-message>
                    @(Model.Status.Equals("failed", StringComparison.OrdinalIgnoreCase)
                        ? "Processing failed."
                        : "Processing this document — parsing, chunking, and embedding for AI search.")
                </span>
                <span class="status-badge @Model.StatusBadgeClass text-capitalize" data-status-badge>@Model.Status</span>
            </div>
            <div class="progress @(Model.IsTerminal ? "d-none" : "")" style="height: 6px;" data-progress-track>
                <div class="progress-bar" role="progressbar" style="width: 0%" data-progress-bar></div>
            </div>
            <div class="text-secondary small @(Model.IsTerminal ? "d-none" : "")" data-stage-label></div>
        </div>
    }
</div>

<div class="card border-light shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        @if (Model.CanPreviewInline)
        {
            <iframe src="@Model.InlineUrl" title="@Model.Title" class="w-100 border-0" style="height: calc(100vh - 220px); min-height: 640px;"></iframe>
        }
        else
        {
            <div class="p-5 text-center">
                <span class="material-icons text-primary mb-3" style="font-size: 56px;">description</span>
                <h3 class="h5 fw-bold">Inline preview is not available for this file type</h3>
                <p class="text-secondary mb-4">This document is stored and available for download.</p>
                <a href="@Model.DownloadUrl" class="btn btn-primary d-inline-flex align-items-center gap-2 px-4 py-2 fw-semibold">
                    <span class="material-icons">download</span> Download Document
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const banner = document.querySelector('[data-processing-banner]');
            if (!banner || banner.dataset.terminal === 'true') {
                return;
            }

            const documentId = banner.dataset.documentId;
            const alertBox = banner.querySelector('[data-banner-alert]');
            const badge = banner.querySelector('[data-status-badge]');
            const message = banner.querySelector('[data-banner-message]');
            const track = banner.querySelector('[data-progress-track]');
            const bar = banner.querySelector('[data-progress-bar]');
            const label = banner.querySelector('[data-stage-label]');
            const viewChunksLink = document.querySelector('[data-view-chunks-link]');

            const statusBadgeClass = status => {
                switch ((status || '').toLowerCase()) {
                    case 'completed':
                    case 'processed':
                        return 'bg-success-subtle text-success';
                    case 'failed':
                        return 'bg-danger-subtle text-danger';
                    case 'processing':
                        return 'bg-info-subtle text-info';
                    case 'queued':
                        return 'bg-warning-subtle text-warning';
                    default:
                        return 'bg-primary-subtle text-primary';
                }
            };

            window.DocumentProcessingHub.subscribe(documentId, update => {
                const status = (update.status || '').toLowerCase();
                const isCompleted = status === 'completed' || status === 'processed';
                const isFailed = status === 'failed';
                const isTerminal = isCompleted || isFailed;

                if (badge) {
                    badge.className = `status-badge ${statusBadgeClass(update.status)} text-capitalize`;
                    badge.textContent = update.status;
                }

                if (isCompleted) {
                    alertBox.classList.remove('alert-info', 'alert-danger');
                    alertBox.classList.add('alert-success');
                    message.textContent = 'Processing complete — this document is ready for AI search.';
                    if (viewChunksLink) {
                        viewChunksLink.classList.remove('d-none');
                    }
                } else if (isFailed) {
                    alertBox.classList.remove('alert-info', 'alert-success');
                    alertBox.classList.add('alert-danger');
                    message.textContent = update.errorMessage
                        ? `Processing failed: ${update.errorMessage}`
                        : 'Processing failed.';
                } else if (typeof update.progressPercent === 'number') {
                    bar.style.width = `${update.progressPercent}%`;
                    label.textContent = update.stageLabel || '';
                }

                if (isTerminal) {
                    track.classList.add('d-none');
                    label.classList.add('d-none');
                    banner.dataset.terminal = 'true';
                }
            });
        })();
    </script>
}
