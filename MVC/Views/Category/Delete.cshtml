@model MVC.ViewModels.CategoryDeleteViewModel

@{
    ViewData["Title"] = "Delete Category";
}

<h1>Delete Category</h1>

<h3 class="text-danger">Are you sure you want to delete this?</h3>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(Model.Description ?? "—")</dd>

            <dt class="col-sm-3">Products</dt>
            <dd class="col-sm-9"><span class="badge bg-info">@Model.ProductCount</span></dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" class="mt-3">
    <input type="hidden" asp-for="CategoryId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>
