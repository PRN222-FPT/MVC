@{
    ViewData["Title"] = "AI Q&A Chat";
}

<div class="row g-4 h-100">
    <div class="col-lg-8 d-flex flex-column" style="height: calc(100vh - 160px);">
        <div class="card border-light shadow-sm rounded-4 flex-grow-1 overflow-hidden d-flex flex-column bg-white">
            <div class="card-body overflow-auto p-4 d-flex flex-column gap-4" id="chatContainer">
                <div class="d-flex gap-3">
                    <div class="flex-shrink-0">
                        <div class="bg-primary-subtle p-2 rounded-3 text-primary">
                            <span class="material-icons">smart_toy</span>
                        </div>
                    </div>
                    <div class="bg-light p-3 rounded-4" style="max-width: 80%;">
                        <p class="mb-0 small">Chào bạn! Tôi là DocAssistant AI. Tôi có thể giúp bạn phân tích tài liệu, tóm tắt nội dung hoặc trả lời các câu hỏi liên quan đến file bạn đã tải lên. Bạn muốn bắt đầu từ đâu?</p>
                    </div>
                </div>

                <div class="d-flex gap-3 flex-row-reverse text-end">
                    <div class="flex-shrink-0">
                        <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Felix" class="rounded-circle bg-primary-subtle" style="width: 40px; height: 40px;" alt="User avatar" />
                    </div>
                    <div class="bg-primary text-white p-3 rounded-4" style="max-width: 80%;">
                        <p class="mb-0 small text-start">Tóm tắt giúp tôi báo cáo tài chính quý 3.</p>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-white border-top p-3">
                <div class="input-group">
                    <input type="text" class="form-control border-0 bg-light py-2 px-3" placeholder="Type your question about documents..." style="border-radius: 12px 0 0 12px;">
                    <button class="btn btn-primary px-4 shadow-sm" style="border-radius: 0 12px 12px 0;">
                        <span class="material-icons fs-5">send</span>
                    </button>
                </div>
                <div class="mt-2 text-center">
                    <p class="text-secondary" style="font-size: 11px;">AI-generated responses can contain errors. Verify critical information.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-light shadow-sm rounded-4 h-100 bg-white">
            <div class="card-header bg-white border-bottom-0 pt-4 px-4 pb-0">
                <h3 class="h6 fw-bold mb-3">Recent Chats</h3>
            </div>
            <div class="card-body p-2 overflow-auto" style="max-height: calc(100vh - 220px);">
                <div class="p-3 rounded-3 mb-1 bg-primary-subtle border-start border-4 border-primary position-relative role-button">
                    <div class="d-flex justify-content-between align-items-start pe-4">
                        <div>
                            <h4 class="small fw-bold mb-1 text-truncate" style="max-width: 180px;">Q3 Financial Analysis</h4>
                            <p class="text-secondary mb-0" style="font-size: 11px;">Today, 10:45 AM</p>
                        </div>
                        <button class="btn btn-link p-0 text-secondary border-0 position-absolute end-0 top-0 mt-3 me-2">
                            <span class="material-icons fs-6">delete_outline</span>
                        </button>
                    </div>
                </div>

                <div class="p-3 rounded-3 mb-1 hover-bg-light position-relative role-button">
                    <div class="d-flex justify-content-between align-items-start pe-4">
                        <div>
                            <h4 class="small fw-medium mb-1 text-truncate" style="max-width: 180px;">Employee Handbook Q&A</h4>
                            <p class="text-secondary mb-0" style="font-size: 11px;">Oct 23, 2023</p>
                        </div>
                        <button class="btn btn-link p-0 text-secondary border-0 position-absolute end-0 top-0 mt-3 me-2">
                            <span class="material-icons fs-6">delete_outline</span>
                        </button>
                    </div>
                </div>

                <div class="p-3 rounded-3 mb-1 hover-bg-light position-relative role-button">
                    <div class="d-flex justify-content-between align-items-start pe-4">
                        <div>
                            <h4 class="small fw-medium mb-1 text-truncate" style="max-width: 180px;">Market Research Trends</h4>
                            <p class="text-secondary mb-0" style="font-size: 11px;">Oct 20, 2023</p>
                        </div>
                        <button class="btn btn-link p-0 text-secondary border-0 position-absolute end-0 top-0 mt-3 me-2">
                            <span class="material-icons fs-6">delete_outline</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-bg-light:hover {
        background-color: #f8f9ff;
        cursor: pointer;
    }
    .role-button {
        cursor: pointer;
        transition: background-color 0.2s;
    }
</style>
