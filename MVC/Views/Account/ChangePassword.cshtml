@model MVC.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<div class="d-flex flex-column gap-4">
    <div>
        <p class="text-secondary fw-bold text-uppercase mb-1" style="font-size: 11px; letter-spacing: .08em;">Account Security</p>
        <h1 class="h3 fw-bold mb-1">Change Password</h1>
        <p class="text-secondary mb-0">Update your sign-in password for this account.</p>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success mb-0">@success</div>
    }

    <div class="row">
        <div class="col-lg-6 col-xl-5">
            <div class="bg-white border rounded-3 p-4">
                <form asp-action="ChangePassword" method="post" class="d-flex flex-column gap-3">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div>
                        <label asp-for="CurrentPassword" class="form-label small fw-bold text-secondary"></label>
                        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div>
                        <label asp-for="NewPassword" class="form-label small fw-bold text-secondary"></label>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div>
                        <label asp-for="ConfirmPassword" class="form-label small fw-bold text-secondary"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary fw-bold d-inline-flex align-items-center justify-content-center gap-2">
                        <span class="material-icons" style="font-size: 20px;">lock_reset</span>
                        Change Password
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
